{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/505.manifest",
      "headers": [
        { "key": "Content-Type", "value": "text/cache-manifest; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/700.manifest",
      "headers": [
        { "key": "Content-Type", "value": "text/cache-manifest; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/900.manifest",
      "headers": [
        { "key": "Content-Type", "value": "text/cache-manifest; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/css.manifest",
      "headers": [
        { "key": "Content-Type", "value": "text/cache-manifest; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/slopkit.manifest",
      "headers": [
        { "key": "Content-Type", "value": "text/cache-manifest; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/media/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
